# macOS
.DS_Store
*.webloc

# Secrets (OPENROUTER_API_KEY must come from the environment, never a file in the repo)
.env
.env.*
!.env.example

# Python / Node
__pycache__/
*.pyc
node_modules/

# Local scratch and model-call caches
.cache/
*.log
tmp/

# Rendered case pages are regenerated from the data by eval/show_case.py
eval/rendered/

# Browser test artefacts
.playwright-mcp/
ui-*.png

# Raw screen recording; the MP4 is the copy that is kept
docs/*.webm

# Narration clips for the walkthrough video (regenerated by docs/narrate.py)
docs/.voice/
