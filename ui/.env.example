# Copy this file to ui/.env and fill in what you need. ui/.env is ignored by git.

# A model key switches on the assistant (the "Assistant" tab) and the AI supervisor on escalated cases.
# Any one of these works; see ui/llm.py.
# GLM_API_KEY=...                 # Z.ai / Zhipu GLM, default model glm-5.3
# OPENROUTER_API_KEY=sk-or-...    # OpenRouter, default model x-ai/grok-4.7
# XAI_API_KEY=xai-...             # xAI (Grok) directly, default model grok-4.7
# LLM_MODEL=glm-5.3               # optional: a different model from the same provider
# LLM_PROVIDER=glm                # optional: which provider to use when several keys are set

# MCP connector. Needed only when an agent outside this machine (for example Grok) connects through a tunnel.
# Pick any long random string; give the same value to the agent as its authorization token.
# MCP_TOKEN=change-me-to-a-long-random-string
